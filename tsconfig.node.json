{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["vite.config.mts", "electron.vite.config.mjs", "electron/**/*.ts", "shared/**/*.ts", "shared/**/*.mts"]
}
