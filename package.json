{
  "name": "box",
  "private": true,
  "version": "1.1.0",
  "description": "面向 Web 应用、内网系统和展示终端的宽松 Electron 浏览器",
  "author": "ASlant <aslant2002@outlook.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.4.2"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:install": "install-electron --no",
    "prestart": "pnpm run electron:install",
    "start": "pnpm run electron:dev",
    "electron:dev": "vite --config electron.vite.config.mjs",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json && pnpm run check:node",
    "check:node": "tsc -p tsconfig.node.json",
    "test": "node --test electron/app-config.test.mts shared/url.test.mts shared/tab-order.test.mts shared/load-error.test.mts",
    "build": "pnpm run test && pnpm run check && vite build",
    "prebuild:electron": "pnpm run electron:install",
    "build:electron": "pnpm run test && pnpm run check && vite build --config electron.vite.config.mjs && electron-builder --publish never",
    "build:win": "pnpm run build:win:x64",
    "build:win:x64": "pnpm run build:electron --win --x64",
    "build:mac": "pnpm run build:electron --mac",
    "build:mac:x64": "pnpm run build:electron --mac --x64",
    "build:mac:arm64": "pnpm run build:electron --mac --arm64",
    "build:linux": "pnpm run build:electron --linux",
    "build:linux:x64": "pnpm run build:electron --linux --x64",
    "build:linux:arm64": "pnpm run build:electron --linux --arm64",
    "release:notes": "node scripts/extract-release-notes.mjs"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  },
  "build": {
    "appId": "top.aslant.box",
    "productName": "Box",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/index.ico"
    ],
    "electronDist": "node_modules/electron/dist",
    "compression": "maximum",
    "asar": true,
    "removePackageScripts": true,
    "electronLanguages": [
      "zh-CN"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "icon": "./assets/index.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Box",
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "./assets/index.ico",
      "uninstallerIcon": "./assets/index.ico",
      "installerHeaderIcon": "./assets/index.ico",
      "differentialPackage": false
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "icon": "./assets/512x512.png"
    },
    "linux": {
      "icon": "assets",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "category": "Utility",
      "maintainer": "ASlant <aslant2002@outlook.com>",
      "vendor": "ASlant",
      "synopsis": "Box",
      "description": "面向 Web 应用、内网系统和展示终端的宽松 Electron 浏览器。"
    }
  }
}
